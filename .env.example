# Copie para ".env" e preencha.

# Porta do servidor (REST + WebSocket). O Resenha Client aponta pra cá.
PORT=4000

# OBRIGATÓRIO. O MESMO banco Turso do site (é ele que tem as tabelas de
# lobby, jogadores e os códigos de pareamento gerados pelo perfil).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Marque como 1 SOMENTE se o backend roda atrás de proxy reverso confiável
# (nginx, Caddy, Railway, Fly…). Faz o rate limit usar o X-Forwarded-For.
# Sem proxy, deixe vazio — senão o header pode ser forjado.
TRUST_PROXY=

# OBRIGATÓRIO. Segredo compartilhado com o site (Vercel) pras rotas internas
# /internal/match/start e /internal/match/end. Gere com: openssl rand -hex 32
# No site, configure as variáveis BACKEND_URL e BACKEND_INTERNAL_KEY.
INTERNAL_API_KEY=

# Controle de versão do Resenha Client (app desktop).
#
# CLIENT_LATEST_VERSION: versão atual. Client mais antigo que isso é BLOQUEADO
# (recebe UPDATE_REQUIRED no HELLO e não coleta nada até atualizar). Se ficar
# vazio, vale o padrão embutido em src/version.js.
CLIENT_LATEST_VERSION=

# CLIENT_DOWNLOAD_URL: link ABSOLUTO do instalador no site. É o que o botão
# "Baixar atualização" do app abre — o app desktop não sabe o endereço do
# site. Ex.: https://seu-site.vercel.app/client/ResenhaClient-setup.exe
CLIENT_DOWNLOAD_URL=
